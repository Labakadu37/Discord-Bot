<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fond d'écran RedSmile -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Overlay « Bienvenue » affiché par-dessus l'écran d'accueil -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- La musique continue une fois l'appli fermée -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bulle IA : reste active et revient après un redémarrage -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Rester actif pour dire bonjour à chaque déverrouillage -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Boîte à outils : IP publique, état du réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Détection à l'écran (capture de l'écran, analysée dans le téléphone) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Pour savoir si Termux est installé (bouton Termux de la boîte à outils) -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".RedSmileApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RedSmile">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WelcomeService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:label="@string/tools_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.monimage.launcher.tools"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bulle flottante et message d'accueil au déverrouillage" />
        </service>

        <service
            android:name=".DetectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
