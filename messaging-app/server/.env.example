# Port du serveur
PORT=3000

# Mot de passe que l'app mobile utilise pour se connecter au serveur (16 caractères minimum).
# Génère-en un avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=

# Identifiants Twilio : https://console.twilio.com (page d'accueil du compte)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Ton numéro Twilio au format international, ex : +33612345678
TWILIO_PHONE_NUMBER=

# Adresse publique du serveur (ex : https://xxxx.ngrok-free.app), utilisée par Twilio
# pour t'envoyer les SMS reçus et les accusés de réception.
PUBLIC_URL=

# Indicatif utilisé quand un numéro commence par 0 (33 = France, 32 = Belgique, 41 = Suisse, 1 = Canada)
DEFAULT_COUNTRY_CODE=33
