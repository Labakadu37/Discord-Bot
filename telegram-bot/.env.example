# Token donné par @BotFather (obligatoire)
TELEGRAM_TOKEN=

# IDs Telegram des admins, séparés par des virgules (pour /stats). Ton ID : @userinfobot
ADMIN_IDS=

# Nombre de téléchargements en même temps (tous utilisateurs confondus)
MAX_PARALLEL=3

# Fichier cookies (format Netscape) pour Instagram/YouTube quand ils bloquent. Optionnel.
COOKIES_FILE=

# Base de données des utilisateurs et stats
DB_PATH=data/bot.db

# Optionnel : serveur Bot API local pour envoyer jusqu'à 2 Go au lieu de 50 Mo
# ex. http://localhost:8081  (voir README)
LOCAL_BOT_API_URL=
